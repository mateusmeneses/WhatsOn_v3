NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
DB_HOST=localhost
DB_PORT=5433
DB_USER=whatson
DB_PASS=whatson
DB_NAME=whatson
DB_LOGGING=false
REDIS_URL=redis://localhost:6380/0
JWT_SECRET=dev-access-secret-change-me-123
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-123
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=troque-esta-chave
# URL pela qual o container da Evolution alcança este backend
BACKEND_PUBLIC_URL=http://host.docker.internal:4000
FRONTEND_URL=http://localhost:5173
MEDIA_DIR=./public/media
INBOUND_SHARDS=8
OUTBOUND_SHARDS=8
SEED_ADMIN_EMAIL=admin@whatson.local
SEED_ADMIN_PASSWORD=admin123
# Super-admin da plataforma (gerencia as empresas); criado na subida se ainda não existir.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Integração com o Manager (só a empresa MANAGER_COMPANY_ID; vazio = desligada).
MANAGER_API_URL=
MANAGER_API_TOKEN=
MANAGER_COMPANY_ID=

# Avisos (webhook) para a Claudia (só a empresa CLAUDIA_COMPANY_ID; vazio = desligado).
CLAUDIA_WEBHOOK_URL=
CLAUDIA_WEBHOOK_KEY=
CLAUDIA_WEBHOOK_KEY_HEADER=Authorization
CLAUDIA_WEBHOOK_EXTRA_HEADERS=
CLAUDIA_WEBHOOK_BODY=json
CLAUDIA_COMPANY_ID=
CLAUDIA_USER_ID=
CLAUDIA_WATCH_NUMBERS=5579988791352
# Formato do aviso: v1 (atual) ou v2 (payload completo, requisitos de 28/10). Trocar para v2 só quando a Claudia estiver pronta.
CLAUDIA_WEBHOOK_FORMATO=v1
# Segredo HMAC (16+ caracteres): com ele, todo aviso leva X-WhatsOn-Timestamp e X-WhatsOn-Assinatura: sha256=<hex>.
CLAUDIA_WEBHOOK_SECRET=
# v2: texto das mensagens em mensagens_recentes (false = só tipo, origem, hora e nº de anexos).
CLAUDIA_WEBHOOK_INCLUIR_TEXTO=false
# v2: minutos de conexão fora até virar conexao_prolongada.
CLAUDIA_CONEXAO_MINUTOS=10
# v2: campo "ambiente" do aviso.
CLAUDIA_AMBIENTE=producao
# economico: só avisa de conversas com a Claudia ou de contatos com Produto em CLAUDIA_PRODUTOS (sem conexão/número vigiado).
CLAUDIA_WEBHOOK_MODO=completo
CLAUDIA_PRODUTOS=multicomercio
# Conversas sem atendente: janela de agrupamento em segundos (com atendente segue 60).
CLAUDIA_AGRUPAR_SEGUNDOS_AGUARDANDO=120
# Automações que resolvem sem acordar a Claudia (true/false) e seus textos (vazio = texto da empresa/conexão).
CLAUDIA_AUTO_REACAO=false
CLAUDIA_AUTO_INATIVIDADE=false
CLAUDIA_TEXTO_LEMBRETE=
CLAUDIA_TEXTO_INATIVIDADE=
CLAUDIA_AUTO_FORA_HORARIO=false
CLAUDIA_TEXTO_FORA_HORARIO=
# Alertas direto às pessoas por WhatsApp: "whatsapp:5579...,whatsapp:5579...".
ALERTA_CONEXAO_DESTINOS=
# Sem aceite 10/20 min: destinos (vazio = os de conexão) e IDs dos técnicos vigiados; com os dois, a Claudia não acorda.
ALERTA_SEM_ACEITE_DESTINOS=
CLAUDIA_ALERTA_TECNICOS=
